<Project>
  <!-- Build settings shared by every project in this repository.
       Project-specific settings belong in each .csproj. -->
  <PropertyGroup>
    <!-- Single source of truth for the app version. Do not define <Version>
         anywhere else; Installer.ps1 reads this value and injects it into the
         Inno Setup script, and checks CHANGELOG.md (if present) for an entry. -->
    <Version>3.0.0</Version>

    <!-- Keep AssemblyInformationalVersion equal to <Version>: the SDK otherwise
         appends "+<git sha>", and the displayed version must stay "AppName X.Y.Z"
         (see docs/rules/standard.md, Version Display). -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>

    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Static analysis: built-in Roslyn analyzers + .editorconfig style rules -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>

    <!-- Warnings are build errors. Never turn this off; relax individual
         diagnostics at the narrowest scope with a reason
         (see docs/rules/dotnet.md, ANALYZERS). -->
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <!-- VSTHRD analyzers enforce the async rules mechanically (e.g. VSTHRD002:
         no .Result/.Wait() blocking on async code). See docs/rules/dotnet.md,
         ASYNC. -->
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.*" PrivateAssets="all" />
  </ItemGroup>

  <!-- The packaging step ships the whole publish directory, and DebugType=none covers
       only this build's own symbols — a native package carries its own beside its
       library (see docs/rules/dotnet.md, NATIVEDEP). -->
  <Target Name="RemoveSymbolsFromPublish"
          AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>

  <!-- A single file that unpacks itself at run time is prohibited: it writes a
       per-build directory under the temp folder that nothing ever deletes. Both
       the project and a framework can turn this on, so the guard checks the
       resolved values (see docs/rules/dotnet.md, NATIVEDEP). -->
  <Target Name="ForbidSelfExtractingPublish"
          BeforeTargets="GenerateSingleFileBundle"
          Condition="'$(IncludeNativeLibrariesForSelfExtract)' == 'true' Or '$(IncludeAllContentForSelfExtract)' == 'true'">
    <Error Text="This single-file publish would unpack itself into the temp folder on every new build, and nothing deletes what it leaves there. IncludeNativeLibrariesForSelfExtract=$(IncludeNativeLibrariesForSelfExtract), IncludeAllContentForSelfExtract=$(IncludeAllContentForSelfExtract). Remove whichever the project sets; where a framework sets it (WinUI 3 does), stop publishing that project as a single file (see docs/rules/dotnet.md, NATIVEDEP)." />
  </Target>
</Project>
